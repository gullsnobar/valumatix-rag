	guard_input -. &nbsp;continue&nbsp; .-> check_corpus;
	guard_input -.-> refuse;
	retrieve -. &nbsp;continue&nbsp; .-> check_relevance;
	retrieve -.-> refuse;
	validate_output -. &nbsp;continue&nbsp; .-> __end__;
